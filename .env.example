##############################################################################
# Provenance API — environment
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# Full walkthrough, including how to obtain the OAuth credentials: ENV_SETUP.md
##############################################################################

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string.
#   Local:  postgresql://postgres:postgres@localhost:5432/provenance
#   Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/provenance"

# --- Auth core --------------------------------------------------------------
# Signs session cookies. Minimum 32 characters. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-character-minimum-random-string"

# Public URL of THIS API. OAuth callback URLs are derived from it.
BETTER_AUTH_URL="http://localhost:4000"

# Public URL of the Next.js frontend. Used for CORS and trusted origins.
FRONTEND_URL="http://localhost:3000"

# Optional extra browser origins, comma-separated (e.g. a preview deployment).
# ADDITIONAL_ORIGINS="https://provenance-preview.vercel.app"

# --- OAuth providers --------------------------------------------------------
# Both values of a pair are required, or leave both blank to disable that
# provider. A half-configured provider fails validation at boot on purpose.
#
# Google  → https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub  → https://github.com/settings/developers
#   Authorization callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Reviewer (lecturer) elevation -----------------------------------------
# Everyone who signs up is a student. Becoming a reviewer requires this code,
# entered during onboarding and checked server-side.
# Leave blank to disable reviewer elevation entirely.
LECTURER_INVITE_CODE="change-this-department-code"

# Optional second gate — only these emails may redeem the code above.
# LECTURER_EMAIL_ALLOWLIST="hod@unizik.edu.ng,lecturer@unizik.edu.ng"

# --- Limits -----------------------------------------------------------------
# Maximum stored thumbnail size, in characters of data URL (~96px JPEG).
MAX_THUMBNAIL_CHARS=60000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
